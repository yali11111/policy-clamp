{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MetricsEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "source",
    "target",
    "timestamp",
    "metrics"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
