{
  "uid": "ran-congestion-overview",
  "title": "RAN Congestion Control Overview",
  "tags": [
    "RAN",
    "O-RAN",
    "congestion",
    "Kafka"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU / process metrics placeholder",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ran"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Available service endpoints",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ran"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up)",
          "legendFormat": "Services up"
        }
      ]
    },
    {
      "id": 3,
      "title": "Application logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki-ran"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"ran-.*\"}"
        }
      ]
    }
  ]
}
